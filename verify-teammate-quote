#!/usr/bin/env bash
# verify-teammate-quote
#
# Verifies that a quoted statement genuinely appears in a teammate's session jsonl
# as role:assistant output — i.e., the persona actually said it, not a phantom
# generated by the coordinator or another agent.
#
# Usage: verify-teammate-quote --sender <persona-name> --quote <text> [OPTIONS]
#
# Exit codes:
#   0  Verified — quote found in at least one role:assistant entry from the sender
#   1  Not verified — quote not found in the sender's assistant output
#   2  Usage error

set -uo pipefail

usage() {
    cat <<'USAGE'
verify-teammate-quote — confirm a teammate actually said what they're claimed to have said

Usage:
  verify-teammate-quote --sender <name> --quote <text> [OPTIONS]

Required:
  --sender <name>      Persona name (e.g. lucos-site-reliability, lucos-architect)
  --quote <text>       Text to search for in the sender's assistant output

Options:
  --session <uuid>     Restrict search to a single session UUID
  --scope today|all    Filter files by mtime: today = only files modified today,
                       all = search all sessions (default: all)
  --json               Output structured JSON instead of human-readable text
  -h, --help           Show this message

Exit codes:
  0  Verified — found in at least one role:assistant entry from the sender
  1  Not verified — not found in the sender's assistant output
  2  Usage error

Examples:
  verify-teammate-quote --sender lucos-site-reliability \
      --quote "No deployment issues detected." --scope today

  verify-teammate-quote --sender lucos-architect \
      --session ffcf4a88-e860-4b3f-ab63-d7d07cd15d03 \
      --quote "ADR-0003 shipped" --json
USAGE
    exit 2
}

SENDER=""
QUOTE=""
SESSION=""
SCOPE="all"
JSON_OUTPUT="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --sender)   SENDER="$2";  shift 2 ;;
        --quote)    QUOTE="$2";   shift 2 ;;
        --session)  SESSION="$2"; shift 2 ;;
        --scope)    SCOPE="$2";   shift 2 ;;
        --json)     JSON_OUTPUT="true"; shift ;;
        -h|--help)  usage ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

if [[ -z "$SENDER" ]]; then
    echo "Error: --sender is required" >&2
    usage
fi
if [[ -z "$QUOTE" ]]; then
    echo "Error: --quote is required" >&2
    usage
fi
if [[ "$SCOPE" != "today" && "$SCOPE" != "all" ]]; then
    echo "Error: --scope must be 'today' or 'all'" >&2
    usage
fi

PROJECTS_DIR="${PROJECTS_DIR:-${HOME}/.claude/projects/-home-lucas-linux-sandboxes}"

# Pass arguments to Python via environment variables to avoid quoting hazards
export _VTQ_SENDER="$SENDER"
export _VTQ_QUOTE="$QUOTE"
export _VTQ_SESSION="$SESSION"
export _VTQ_SCOPE="$SCOPE"
export _VTQ_JSON="$JSON_OUTPUT"
export _VTQ_PROJECTS="$PROJECTS_DIR"

python3 - <<'PYEOF'
import json
import os
import sys
import glob
from datetime import date, datetime

sender      = os.environ["_VTQ_SENDER"]
quote       = os.environ["_VTQ_QUOTE"]
session_uuid = os.environ.get("_VTQ_SESSION", "")
scope       = os.environ.get("_VTQ_SCOPE", "all")
json_output = os.environ.get("_VTQ_JSON", "false") == "true"
projects_dir = os.environ["_VTQ_PROJECTS"]


def build_candidate_list():
    """Return list of jsonl paths to search."""
    if session_uuid:
        return [os.path.join(projects_dir, f"{session_uuid}.jsonl")]
    all_files = glob.glob(os.path.join(projects_dir, "*.jsonl"))
    if scope == "today":
        today_start = datetime.combine(date.today(), datetime.min.time()).timestamp()
        return [f for f in all_files if os.path.getmtime(f) >= today_start]
    return all_files


def extract_searchable_text(content):
    """
    Flatten a message content field into a searchable string.
    Handles:
      - Plain string content
      - List of content blocks (text, tool_use, thinking, etc.)
    Includes tool_use inputs so SendMessage bodies are searchable.
    """
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        btype = block.get("type", "")
        if btype == "text":
            parts.append(block.get("text", ""))
        elif btype == "tool_use":
            # Captures SendMessage content, Bash commands, etc.
            inp = block.get("input")
            if inp is not None:
                parts.append(json.dumps(inp, ensure_ascii=False))
    return "\n".join(parts)


matches = []
parse_errors = []

for filepath in sorted(build_candidate_list()):
    if not os.path.exists(filepath):
        if session_uuid:
            parse_errors.append(f"Session file not found: {filepath}")
        continue
    try:
        with open(filepath, encoding="utf-8", errors="replace") as fh:
            for lineno, raw in enumerate(fh, 1):
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    entry = json.loads(raw)
                except json.JSONDecodeError:
                    continue

                # Filter by persona name
                if entry.get("agentName") != sender:
                    continue

                # Filter by role: must be the persona's own output
                msg = entry.get("message")
                if not isinstance(msg, dict):
                    continue
                if msg.get("role") != "assistant":
                    continue

                # Search the flattened content
                text = extract_searchable_text(msg.get("content", ""))
                if quote not in text:
                    continue

                matches.append({
                    "file": filepath,
                    "session": entry.get(
                        "sessionId",
                        os.path.basename(filepath).replace(".jsonl", "")
                    ),
                    "line": lineno,
                    "timestamp": entry.get("timestamp", "unknown"),
                    "agent": sender,
                    "role": "assistant",
                })
    except OSError as exc:
        parse_errors.append(f"{filepath}: {exc}")

found = bool(matches)

if json_output:
    print(json.dumps({
        "sender": sender,
        "quote": quote,
        "verified": found,
        "match_count": len(matches),
        "matches": matches,
        "errors": parse_errors,
    }, indent=2))
else:
    q_preview = quote[:70] + ("..." if len(quote) > 70 else "")
    if found:
        print(f"✓ VERIFIED: '{q_preview}'")
        print(f"  Sender : {sender}")
        print(f"  Matches: {len(matches)}")
        for m in matches:
            short_session = m["session"][:8] if len(m["session"]) >= 8 else m["session"]
            print(f"  → session {short_session}... line {m['line']}  @ {m['timestamp']}")
    else:
        print(f"✗ NOT VERIFIED: '{q_preview}'")
        print(f"  Sender : {sender}")
        print(f"  No role:assistant entries from {sender} contain this text.")
    if parse_errors:
        for err in parse_errors:
            print(f"  Warning: {err}", file=sys.stderr)

sys.exit(0 if found else 1)
PYEOF
