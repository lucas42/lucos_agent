#!/usr/bin/env bash
# Smoke test for verify-teammate-quote
#
# Verifies the script against a small synthetic fixture jsonl checked into
# this repo (tests/fixtures/verify-teammate-quote/), rather than this
# machine's real production session history. Points PROJECTS_DIR at the
# fixture directory so the test is portable to a fresh CircleCI checkout
# with no reliance on ${HOME}/.claude/projects existing.
#
# The fixture matches the schema verify-teammate-quote actually parses
# (agentName, message.role, message.content) but contains no real
# conversation content — see lucas42/lucos_agent#76.
#
# Usage: tests/verify-teammate-quote  (run from the lucos_agent repo root)

set -euo pipefail

SCRIPT="$(dirname "$0")/../verify-teammate-quote"
export PROJECTS_DIR="$(dirname "$0")/fixtures/verify-teammate-quote"

KNOWN_SESSION="fixture-0001"
KNOWN_SENDER="test-persona"
KNOWN_QUOTE="This is a known good fixture quote for verify-teammate-quote testing."
ABSENT_QUOTE="__verify_teammate_quote_test_string_that_cannot_appear_in_any_session__"
WRONG_SENDER="test-persona-other"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local expected_exit="$2"
    shift 2
    local actual_exit=0
    "$SCRIPT" "$@" > /dev/null 2>&1 || actual_exit=$?
    if [[ "$actual_exit" -eq "$expected_exit" ]]; then
        echo "  PASS  $desc"
        PASS=$((PASS + 1))
    else
        echo "  FAIL  $desc (expected exit $expected_exit, got $actual_exit)"
        FAIL=$((FAIL + 1))
    fi
}

echo "verify-teammate-quote smoke tests"
echo "----------------------------------"

# --- Happy path: fixture quote, verified ---
check "known good quote exits 0" 0 \
    --sender "$KNOWN_SENDER" \
    --session "$KNOWN_SESSION" \
    --quote  "$KNOWN_QUOTE"

# --- Happy path: --json flag still exits 0 on a match ---
check "known good quote with --json exits 0" 0 \
    --sender "$KNOWN_SENDER" \
    --session "$KNOWN_SESSION" \
    --quote  "$KNOWN_QUOTE" \
    --json

# --- Not found: invented text exits 1 ---
check "absent quote exits 1" 1 \
    --sender "$KNOWN_SENDER" \
    --session "$KNOWN_SESSION" \
    --quote  "$ABSENT_QUOTE"

# --- Wrong sender: real quote attributed to a different persona exits 1 ---
check "real quote attributed to wrong sender exits 1" 1 \
    --sender "$WRONG_SENDER" \
    --session "$KNOWN_SESSION" \
    --quote  "$KNOWN_QUOTE"

# --- Usage error: missing --quote exits 2 ---
actual_exit=0
"$SCRIPT" --sender "$KNOWN_SENDER" > /dev/null 2>&1 || actual_exit=$?
if [[ "$actual_exit" -eq 2 ]]; then
    echo "  PASS  missing --quote exits 2"
    PASS=$((PASS + 1))
else
    echo "  FAIL  missing --quote (expected exit 2, got $actual_exit)"
    FAIL=$((FAIL + 1))
fi

echo "----------------------------------"
echo "Results: $PASS passed, $FAIL failed"

[[ "$FAIL" -eq 0 ]]
