#!/bin/bash
# commit-claude-main
#
# Commit one or more files from ~/.claude directly onto origin/main via an
# isolated temporary git worktree.  Never touches the shared working tree —
# does not checkout, stash, discard or modify any branch; just reads the files
# you specify and pushes them as a fast-forward on main.
#
# Designed to solve the race condition where the coordinator needs to commit a
# config change but the shared working tree is dirty with other agents'
# uncommitted memory files (which would block a plain `git pull --ff-only`).
#
# Usage:
#   commit-claude-main --app <persona> -m <message> <file> [<file>...]
#   commit-claude-main --app <persona> -m <message> --delete <file> [--delete <file>...]
#   (the two forms combine freely — add/update some files, delete others, in one commit)
#
#   --app      lucos GitHub App persona name (same as git-as-agent / gh-as-agent)
#   -m         commit message (required)
#   files      paths relative to ~/.claude/, e.g. "agents/CLAUDE.md" — added/updated
#              from the live working tree. Must exist on disk. Absolute paths under
#              ~/.claude/ are also accepted.
#   --delete   path (relative or absolute, same rules as above) to remove from
#              origin/main. Does NOT need to exist on disk — that's the point: it
#              covers a file that's already gone locally (or was never meant to be
#              there — e.g. a stray temp file that got committed by accident) but
#              is still tracked on origin/main. Repeatable. A path not present on
#              origin/main is a no-op note, not an error.
#
# On success, prints the commit SHA to stdout and exits 0.
# On "nothing to change", prints a note and exits 0.
# On push failure (concurrent push between fetch and push), exits non-zero —
# simply re-run the command to retry.

set -euo pipefail

CLAUDE_DIR="/home/lucas.linux/.claude"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PERSONAS_FILE="$SCRIPT_DIR/personas.json"

# Use the lucos-agent SSH key (no passphrase; works in non-interactive contexts)
export GIT_SSH_COMMAND="ssh -i /home/lucas.linux/.ssh/id_ed25519_lucos_agent \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=accept-new"

# ---------- argument parsing --------------------------------------------------

APP_NAME=""
COMMIT_MSG=""
FILES=()
DELETES=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --app)
            APP_NAME="${2:?--app requires an argument}"
            shift 2
            ;;
        -m|--message)
            COMMIT_MSG="${2:?-m requires an argument}"
            shift 2
            ;;
        --delete)
            DELETES+=("${2:?--delete requires an argument}")
            shift 2
            ;;
        --help|-h)
            sed -n '2,/^set -/p' "$0" | grep '^#' | sed 's/^# \?//'
            exit 0
            ;;
        -*)
            echo "Error: unknown flag '$1'" >&2
            echo "Usage: commit-claude-main --app <persona> -m <message> [<file>...] [--delete <file>]..." >&2
            exit 1
            ;;
        *)
            FILES+=("$1")
            shift
            ;;
    esac
done

[[ -n "$APP_NAME" ]]   || { echo "Error: --app is required" >&2; exit 1; }
[[ -n "$COMMIT_MSG" ]] || { echo "Error: -m is required" >&2; exit 1; }
[[ ${#FILES[@]} -gt 0 || ${#DELETES[@]} -gt 0 ]] || {
    echo "Error: at least one file path (to add/update) or --delete <path> (to remove) is required" >&2
    exit 1
}

# ---------- identity lookup ---------------------------------------------------

BOT_NAME=$(jq -r --arg app "$APP_NAME" '.[$app].bot_name // empty' "$PERSONAS_FILE")
BOT_USER_ID=$(jq -r --arg app "$APP_NAME" '.[$app].bot_user_id // empty' "$PERSONAS_FILE")

if [[ -z "$BOT_NAME" || -z "$BOT_USER_ID" ]]; then
    echo "Error: unknown persona '$APP_NAME'" >&2
    echo "Known personas: $(jq -r 'keys | join(", ")' "$PERSONAS_FILE")" >&2
    exit 1
fi

BOT_EMAIL="${BOT_USER_ID}+${BOT_NAME}@users.noreply.github.com"

# ---------- resolve & validate file paths ------------------------------------

RESOLVED=()
for f in "${FILES[@]:-}"; do
    [[ -z "$f" ]] && continue
    # Strip common absolute-path prefixes so callers can pass either form
    f="${f#"$CLAUDE_DIR/"}"
    f="${f#"$HOME/.claude/"}"
    f="${f#./}"
    if [[ ! -f "$CLAUDE_DIR/$f" ]]; then
        echo "Error: file not found in ~/.claude/: $f" >&2
        exit 1
    fi
    RESOLVED+=("$f")
done

# --delete paths deliberately skip the disk-existence check above — deleting a
# file that's already gone locally (or was accidentally committed and never
# should have been) is exactly the use case. Whether it's actually present on
# origin/main is checked later, once we're looking at the worktree copy.
RESOLVED_DELETES=()
for f in "${DELETES[@]:-}"; do
    [[ -z "$f" ]] && continue
    f="${f#"$CLAUDE_DIR/"}"
    f="${f#"$HOME/.claude/"}"
    f="${f#./}"
    RESOLVED_DELETES+=("$f")
done

# ---------- fetch & commit via throwaway worktree ----------------------------

cd "$CLAUDE_DIR"
git fetch --quiet origin main

WORKTREE=$(mktemp -d)
git worktree add --quiet --detach "$WORKTREE" origin/main

_cleanup() {
    cd "$CLAUDE_DIR"
    git worktree remove --force "$WORKTREE" 2>/dev/null || true
}
trap _cleanup EXIT

# Copy each specified file into the worktree, preserving directory structure
for f in "${RESOLVED[@]:-}"; do
    [[ -z "$f" ]] && continue
    mkdir -p "$(dirname "$WORKTREE/$f")"
    cp "$CLAUDE_DIR/$f" "$WORKTREE/$f"
done

cd "$WORKTREE"
if [[ ${#RESOLVED[@]} -gt 0 ]]; then
    git add -- "${RESOLVED[@]}"
fi

# Remove each --delete path from the worktree, if it's there to remove. A path
# origin/main doesn't have is reported, not treated as an error — the caller
# may be idempotently re-running, or may be wrong about what's tracked.
for f in "${RESOLVED_DELETES[@]:-}"; do
    [[ -z "$f" ]] && continue
    if [[ -f "$WORKTREE/$f" ]]; then
        git rm --quiet -- "$f"
    else
        echo "Note: '$f' not present on origin/main — nothing to delete." >&2
    fi
done

# If nothing changed, the result already matches origin/main — no commit needed
if git diff --quiet --cached; then
    echo "Nothing to commit: result already matches origin/main."
    exit 0
fi

git \
    -c "user.name=${BOT_NAME}" \
    -c "user.email=${BOT_EMAIL}" \
    commit -m "$COMMIT_MSG" >&2

git push origin HEAD:main >&2

# Print the commit SHA to stdout — stderr carries all other output so the
# caller can capture just the SHA cleanly with $(...).
git rev-parse HEAD
